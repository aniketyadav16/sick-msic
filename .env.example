# Required: backend access to your R2 bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Password already defaults to minion. Override only if desired:
# UPLOAD_PASSWORD=minion

# For a separately hosted Vercel frontend:
# Backend setting: ALLOWED_ORIGINS=https://your-app.vercel.app
# Vercel setting: VITE_API_BASE_URL=https://your-backend.example.com
